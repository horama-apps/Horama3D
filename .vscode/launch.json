{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Horama3D: Vite + Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://127.0.0.1:5173",
      "webRoot": "${workspaceFolder}/src",
      "preLaunchTask": "Horama3D: npm run dev",
      "sourceMaps": true
    },
    {
      "name": "Horama3D: Attach Chrome",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}/src",
      "sourceMaps": true
    }
  ],
  "compounds": []
}
